# Milla Privada · Hostinger (Apache/LiteSpeed)
# Web subida pero sin lanzar: que no la indexe ningún buscador.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Siempre por HTTPS y sin «www»
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://millaprivada.com%{REQUEST_URI} [L,R=301]

# La portada lleva directa a Barcelona
RewriteRule ^$ /barcelona/ [L,R=302]

# Tipos de archivo
AddType video/mp4 .mp4
AddType audio/mpeg .mp3
AddType video/webm .webm
AddType image/webp .webp
AddType image/svg+xml .svg

# Caché: medios 30 días, páginas siempre frescas
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes
