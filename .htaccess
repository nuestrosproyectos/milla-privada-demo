# Milla Privada · Hostinger (Apache/LiteSpeed)
<IfModule mod_headers.c>
  # Seguridad: nadie puede meter la web dentro de otra página (copias falsas con otro WhatsApp),
  # siempre HTTPS, el navegador no "adivina" tipos de archivo y no se filtra la URL completa a otras webs.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # La página nunca se guarda en el CDN ni en el navegador: así cada cambio se ve al momento.
  # Los vídeos e imágenes sí se guardan, porque su enlace lleva ?v=<huella> y cambia cuando cambian.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set CDN-Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Siempre por HTTPS y sin «www»
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://millaprivada.com%{REQUEST_URI} [L,R=301]

# Las rutas de Mallorca ahora están en /rutas/palma/
RewriteRule ^rutas/mallorca/?(.*)$ /rutas/palma/$1 [L,R=301]

# La portada lleva directa a Barcelona
RewriteRule ^$ /madrid/ [L,R=302]

# Tipos de archivo
AddType video/mp4 .mp4
AddType audio/mpeg .mp3
AddType video/webm .webm
AddType image/webp .webp
AddType image/svg+xml .svg

# Caché: medios 30 días, páginas siempre frescas
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes

# Subtítulos del tráiler
AddType text/vtt .vtt
AddType application/javascript .js
